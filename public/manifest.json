{
  "manifest_version": 3,
  "name": "Cocoon",
  "version": "0.2.0",
  "description": "Adds useful controls to the Zhihu home feed.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cocoon"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
